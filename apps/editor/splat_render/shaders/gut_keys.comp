#version 450
#extension GL_GOOGLE_include_directive : require
#include "gut_frame.glsl"

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) uniform FrameBlock { GutFrame frame; } frame_block;
layout(set = 0, binding = 1) readonly buffer Centers { vec4 centers[]; };
layout(set = 0, binding = 6) writeonly buffer Keys0 { uint keys0[]; };
layout(set = 0, binding = 8) writeonly buffer Vals0 { uint vals0[]; };

layout(push_constant) uniform Push {
    uint count;
    uint groups;
    uint shift;
    uint parity;
} push;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= push.count) return;
    vec3 world = centers[index].xyz;
    vec3 camera = (frame_block.frame.world_to_camera * vec4(world, 1.0)).xyz;
    int model = int(frame_block.frame.eye.w + 0.5);
    float depth = model == k_model_equirect ? length(camera) : camera.z;
    uint key = 0xffffffffu;
    if (model == k_model_equirect || depth > 1e-4) key = ~gut_sortable(depth);
    keys0[index] = key;
    vals0[index] = index;
}
