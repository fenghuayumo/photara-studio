# One ggml build shared by all image-model adapters. Keep its source location
# until the bundled SAM/ggml dependency can be upgraded separately.
option(PHOTARA_ENABLE_INFERENCE "Build shared image-model inference support" ON)
option(PHOTARA_ENABLE_SAM_VULKAN "Legacy default for inference Vulkan support" ON)
option(PHOTARA_ENABLE_SAM_CUDA "Legacy default for inference CUDA support" OFF)
option(PHOTARA_INFERENCE_VULKAN "Build the ggml Vulkan inference backend"
    ${PHOTARA_ENABLE_SAM_VULKAN})
option(PHOTARA_INFERENCE_CUDA "Build the optional ggml CUDA inference backend"
    ${PHOTARA_ENABLE_SAM_CUDA})
set(PHOTARA_GGML_ROOT "${CMAKE_SOURCE_DIR}/third_party/sam3/ggml" CACHE PATH
    "Path to the ggml source shared by image models")
set(PHOTARA_HAS_INFERENCE OFF)
if(NOT PHOTARA_ENABLE_INFERENCE)
    return()
endif()
if(NOT EXISTS "${PHOTARA_GGML_ROOT}/CMakeLists.txt")
    message(FATAL_ERROR "Inference requires ggml at PHOTARA_GGML_ROOT")
endif()
set(GGML_CCACHE OFF CACHE BOOL "" FORCE)
set(GGML_STATIC OFF CACHE BOOL "" FORCE)
set(GGML_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(GGML_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(GGML_CPU ON CACHE BOOL "" FORCE)
set(GGML_METAL OFF CACHE BOOL "" FORCE)
set(GGML_BLAS OFF CACHE BOOL "" FORCE)
set(GGML_VULKAN OFF CACHE BOOL "" FORCE)
if(PHOTARA_INFERENCE_VULKAN)
    find_package(Vulkan QUIET COMPONENTS glslc)
    if(Vulkan_FOUND AND Vulkan_GLSLC_EXECUTABLE)
        set(GGML_VULKAN ON CACHE BOOL "" FORCE)
    else()
        message(WARNING "Inference: Vulkan SDK/glslc not found; CPU backend only")
    endif()
endif()
set(GGML_CUDA OFF CACHE BOOL "" FORCE)
if(PHOTARA_INFERENCE_CUDA)
    include(CheckLanguage)
    check_language(CUDA)
    if(NOT CMAKE_CUDA_COMPILER)
        message(FATAL_ERROR "PHOTARA_INFERENCE_CUDA requires a CUDA compiler")
    endif()
    enable_language(CUDA)
    photara_resolve_cuda_architectures(_photara_inference_cuda_architectures)
    set(CMAKE_CUDA_RUNTIME_LIBRARY Shared CACHE STRING "" FORCE)
    set(GGML_CUDA ON CACHE BOOL "" FORCE)
endif()
add_subdirectory("${PHOTARA_GGML_ROOT}" "${CMAKE_BINARY_DIR}/ggml")
if(TARGET ggml-cuda)
    set_target_properties(ggml-cuda PROPERTIES
        CUDA_ARCHITECTURES "${_photara_inference_cuda_architectures}")
endif()
set(PHOTARA_HAS_INFERENCE ON)
