#version 450
layout(local_size_x = 256) in;

layout(set = 0, binding = 6) readonly buffer Keys0 { uint keys0[]; };
layout(set = 0, binding = 7) readonly buffer Keys1 { uint keys1[]; };
layout(set = 0, binding = 10) writeonly buffer WgCounts { uint wg_counts[]; };
layout(set = 0, binding = 12) writeonly buffer Ranks { uint ranks[]; };

layout(push_constant) uniform Push {
    uint count;
    uint groups;
    uint shift;
    uint parity;
} push;

shared uint digits[256];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint group = gl_WorkGroupID.x;
    uint index = group * 256u + tid;
    uint digit = 0u;
    if (index < push.count) {
        uint key = push.parity == 0u ? keys0[index] : keys1[index];
        digit = (key >> push.shift) & 255u;
    }
    digits[tid] = digit;
    barrier();
    if (tid != 0u) return;

    uint hist[256];
    uint cursor[256];
    for (int bin = 0; bin < 256; ++bin) hist[bin] = 0u;
    uint limit = 256u;
    uint base = group * 256u;
    if (base >= push.count) limit = 0u;
    else limit = min(256u, push.count - base);
    for (uint item = 0u; item < limit; ++item) hist[digits[item]]++;

    // Rank inside this workgroup's digit. The global bin start is added
    // when scattering, so this must not include counts of lower digits.
    for (int bin = 0; bin < 256; ++bin) {
        wg_counts[group * 256u + uint(bin)] = hist[bin];
        cursor[bin] = 0u;
    }
    for (uint item = 0u; item < limit; ++item) {
        uint bin = digits[item];
        ranks[base + item] = cursor[bin];
        cursor[bin]++;
    }
}
