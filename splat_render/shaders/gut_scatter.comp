#version 450
layout(local_size_x = 256) in;

layout(set = 0, binding = 6) buffer Keys0 { uint keys0[]; };
layout(set = 0, binding = 7) buffer Keys1 { uint keys1[]; };
layout(set = 0, binding = 8) buffer Vals0 { uint vals0[]; };
layout(set = 0, binding = 9) buffer Vals1 { uint vals1[]; };
layout(set = 0, binding = 11) readonly buffer WgOffsets { uint wg_offsets[]; };
layout(set = 0, binding = 12) readonly buffer Ranks { uint ranks[]; };
layout(set = 0, binding = 14) readonly buffer BinStart { uint bin_start[]; };

layout(push_constant) uniform Push {
    uint count;
    uint groups;
    uint shift;
    uint parity;
} push;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= push.count) return;
    uint group = index >> 8u;
    uint key = push.parity == 0u ? keys0[index] : keys1[index];
    uint value = push.parity == 0u ? vals0[index] : vals1[index];
    uint digit = (key >> push.shift) & 255u;
    uint dest = bin_start[digit] + wg_offsets[group * 256u + digit] + ranks[index];
    if (push.parity == 0u) {
        keys1[dest] = key;
        vals1[dest] = value;
    } else {
        keys0[dest] = key;
        vals0[dest] = value;
    }
}
